---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This page could not be found. Explore city brunch, happy hour and dining deals guides from Destination : Brunch." noindex>
  <header class="page-head">
    <div class="wrap">
      <h1>Lost your <em>way?</em></h1>
      <p>We couldn't find that page. It may have moved, or the guide may not be available yet.</p>
      <div class="hero-actions" style="justify-content:flex-start;margin-top:24px">
        <a class="btn btn-gold" href="/destinations">Explore Destinations</a>
        <a class="btn btn-outline-light" href="/">Go to homepage</a>
      </div>
    </div>
  </header>
  <div class="section"></div>
</BaseLayout>
