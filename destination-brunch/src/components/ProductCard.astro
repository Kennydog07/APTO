---
import type { Product } from '../data/products';
import Cover from './Cover.astro';
import Price from './Price.astro';
import BuyButton from './BuyButton.astro';
import { CATEGORIES } from '../data/categories';
import { destinationOf, priceOf, saleState, categoriesOf } from '../lib/catalog';

interface Props { product: Product; headingLevel?: 'h2' | 'h3' }
const { product: p, headingLevel = 'h3' } = Astro.props;
const d = destinationOf(p);
const state = saleState(p);
const H = headingLevel;
const url = `/guides/${p.id}`;
const cats = categoriesOf(p);
const kind = cats.map((c) => CATEGORIES[c].label).join(' & ');
---
<article
  class="pcard rise"
  data-item
  data-name={d.city.toLowerCase()}
  data-search={`${d.city} ${d.country} ${d.region} ${p.title} ${kind}`.toLowerCase()}
  data-region={d.region}
  data-cats={cats.join(' ')}
  data-price={priceOf(p)}
>
  <a href={url} tabindex="-1" aria-hidden="true">
    <Cover destination={d} src={p.coverImage}>
      <div class="badges">
        {cats.map((c) => <span class={`badge cat-${c}`}>{CATEGORIES[c].label}</span>)}
        {state === 'coming-soon' && <span class="badge soon">Coming soon</span>}
        {state === 'draft' && <span class="badge draft">Draft</span>}
      </div>
      <div class="on-photo"><b>{d.city}</b><span>{d.country}</span></div>
    </Cover>
  </a>
  <div class="body">
    <p class="dest">{d.city} · {kind} guide</p>
    <H><a href={url}>{p.title}</a></H>
    <p class="desc">{p.shortDescription}</p>
    <ul class="benefits" aria-label="Key benefits">
      {p.highlights.map((h) => <li>{h}</li>)}
    </ul>
    <a class="more" href={url}>See what's inside<span class="sr-only"> {p.title}</span> →</a>
    <div class="price-row">
      <Price product={p} />
      <BuyButton product={p} note={false} place="card" />
    </div>
  </div>
</article>
