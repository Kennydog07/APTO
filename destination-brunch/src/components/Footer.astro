const socials = Object.entries(SITE.social).filter(([, url]) => url);
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="fb">
        <div class="foot-brand"><span class="brand-mark sm" aria-hidden="true">D</span> Destination <em>: Brunch</em></div>
        <p class="foot-small">{SITE.tagline}</p>
        <p class="foot-small">Destination : Brunch is an independent guide publisher. We are not affiliated with or endorsed by the venues listed. Restaurant offers change, so please confirm prices and availability with the venue.</p>
        <p class="foot-small">Payments and delivery are handled securely by Gumroad.</p>
        {socials.length > 0 && (
          <div class="socials">
            {socials.map(([name, url]) => (
              <a href={url} target="_blank" rel="noopener me" aria-label={`Destination : Brunch on ${name}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[name]} /></svg>
              </a>
            ))}
          </div>
        )}
      </div>
      <nav aria-labelledby="f-dest">
        <h2 id="f-dest">Destinations</h2>
        <ul>{cities.map((d) => <li><a href={`/destinations/${d.slug}`}>{d.city}</a></li>)}</ul>
      </nav>
      <nav aria-labelledby="f-shop">
        <h2 id="f-shop">Guides</h2>
        <ul>
          <li><a href="/guides">All guides</a></li>
          <li><a href="/guides?cat=brunch">Brunch guides</a></li>
          <li><a href="/guides?cat=daily-deals">Daily deals guides</a></li>
          <li><a href="/#how-it-works">How it works</a></li>
          <li><a href="/#faq">FAQ</a></li>
        </ul>
      </nav>
      <nav aria-labelledby="f-info">
        <h2 id="f-info">Information</h2>
        <ul>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/refunds">Refunds &amp; delivery</a></li>
          <li><a href="/disclaimer">Restaurant offers disclaimer</a></li>
          <li><a href="/terms">Terms &amp; conditions</a></li>
          <li><a href="/privacy">Privacy policy</a></li>
          <li><a href="/credits">Photo credits</a></li>
        </ul>
      </nav>
    </div>
    <div class="foot-bottom">
      <span>&copy; {year} {SITE.legalName || SITE.name}. All rights reserved.</span>
      <span>Prices shown in US dollars (USD).</span>
    </div>
  </div>
</footer>
