  "recipes": [
    {
      "name": "Spinach and chickpea curry with rice",
      "serves": 4,
      "minutes": 30,
      "ingredients": [
        "1 onion, chopped",
        "2 garlic cloves",
        "2 tbsp mild curry paste",
        "2 x 400g tins chickpeas",
        "400g tin chopped tomatoes",
        "100g spinach",
        "4 tbsp natural yoghurt",
        "300g basmati rice"
      ],
      "steps": [
        "Cook the rice following the pack.",
        "Soften the onion and garlic in a little oil for 5 minutes.",
        "Stir in the curry paste, then the chickpeas and tomatoes. Simmer for 15 minutes.",
        "Stir through the spinach until wilted and serve with rice and a spoon of yoghurt."
      ]
    },
    {
      "name": "Slow cooker beef chilli",
      "serves": 8,
      "minutes": 25,
      "ingredients": [
        "750g beef mince",
        "2 onions, chopped",
        "2 peppers, chopped",
        "2 x 400g tins kidney beans",
        "2 x 400g tins chopped tomatoes",
        "2 tsp mild chilli powder",
        "1 tsp ground cumin",
        "1 beef stock cube"
      ],
      "steps": [
        "Brown the mince in a pan, then tip into the slow cooker.",
        "Add the onions, peppers, beans, tomatoes, spices and crumbled stock cube.",
        "Cook on low for 6-8 hours.",
        "Serve half with rice; cool and fridge the rest for Thursday."
      ]
    },
    {
      "name": "Lemon chicken traybake with potatoes",
      "serves": 4,
      "minutes": 45,
      "ingredients": [
        "8 chicken thighs",
        "800g baby potatoes, halved",
        "2 courgettes, chunked",
        "1 red onion, wedged",
        "1 lemon",
        "2 tbsp olive oil",
        "1 tsp dried oregano"
      ],
      "steps": [
        "Heat the oven to 200C (180C fan).",
        "Toss everything in a large tin with oil, oregano, salt and the lemon juice.",
        "Roast for 40-45 minutes until the chicken is cooked through and golden."
      ]
    },
    {
      "name": "Salmon fishcakes with peas",
      "serves": 4,
      "minutes": 30,
      "ingredients": [
        "2 x 213g tins pink salmon",
        "500g potatoes",
        "2 spring onions",
        "1 egg",
        "50g breadcrumbs",
        "300g frozen peas"
      ],
      "steps": [
        "Boil the potatoes for 15 minutes, drain and mash.",
        "Mix in the salmon, spring onions and egg. Shape into 8 cakes.",
        "Coat in breadcrumbs and fry for 3-4 minutes each side.",
        "Serve with peas."
      ]
    },
    {
      "name": "Cheese and tomato pasta bake",
      "serves": 4,
      "minutes": 30,
      "ingredients": [
        "400g pasta",
        "500g jar tomato pasta sauce",
        "100g spinach",
        "150g grated cheddar"
      ],
      "steps": [
        "Heat the oven to 200C (180C fan). Cook the pasta for 8 minutes.",
        "Drain and mix with the sauce and spinach.",
        "Tip into a dish, top with cheese and bake for 15 minutes."
      ]
    },
    {
      "name": "Sunday roast chicken",
      "serves": 4,
      "minutes": 90,
      "ingredients": [
        "1.5kg whole chicken",
        "1kg potatoes",
        "500g carrots",
        "2 tbsp gravy granules",
        "300g frozen peas"
      ],
      "steps": [
        "Heat the oven to 190C (170C fan). Roast the chicken for about 1 hour 20 minutes until the juices run clear.",
        "Parboil the potatoes for 8 minutes, then roast for 50 minutes.",
        "Boil the carrots and peas, make the gravy and carve."
      ]
    }
  ],
