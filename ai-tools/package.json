{
  "name": "apto-ai-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pay-per-use AI mini tools (parking appeal, bedtime story, speech, listing, CV).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:netlify": "netlify dev",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build:client && npm run build:ssr && npm run prerender",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "seed": "node --env-file-if-exists=.env scripts/seed-samples.ts",
    "e2e": "node --env-file-if-exists=.env scripts/e2e.ts",
    "merge-kit": "node scripts/gen-merge-kit.mjs",
    "build:functions": "vite build -c vite.functions.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "docx": "^9.15.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.37.0",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@netlify/functions": "^6.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
