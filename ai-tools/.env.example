# ---- Server-side secrets (Netlify site settings > Environment variables). NEVER prefix with VITE_. ----
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
RESEND_API_KEY=re_...
# Must be on a domain you have verified in Resend
FROM_EMAIL="APTO Quick Tools <hello@yourdomain.co.uk>"
# Public URL of the site, no trailing slash. Used for Stripe return URLs, emails and canonical URLs.
SITE_URL=http://localhost:8888
# Long random string. The marketing bot sends it as ?key=
STATS_API_KEY=change-me-to-a-long-random-string
# Daily AI spend cap in GBP. When reached, new checkouts pause ("back shortly").
DAILY_AI_BUDGET_GBP=10

# ---- Optional, public (safe to expose) ----
# Cookie-free Plausible analytics. Leave blank to disable analytics entirely.
PLAUSIBLE_DOMAIN=

# ---- Optional tuning ----
# Listing writer: how long /api/listing-generate waits for the AI before handing over to the
# background function. Must stay below the site's synchronous function limit (Netlify default 10s).
# If your Netlify plan allows a 26s limit, you can raise this to 20000.
LISTING_SYNC_TIMEOUT_MS=8000
