{
  "name": "ops-service",
  "version": "1.0.0",
  "private": true,
  "description": "Integration service for the UK store: verified Shopify webhooks, order routing, pricing, inventory, support, marketing queue, reports and owner dashboard.",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "score-products": "node --disable-warning=ExperimentalWarning scripts/score-products.js",
    "pricing-report": "node --disable-warning=ExperimentalWarning scripts/pricing-report.js",
    "hash-password": "node scripts/hash-password.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "restore": "node --disable-warning=ExperimentalWarning scripts/restore.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0"
  }
}
