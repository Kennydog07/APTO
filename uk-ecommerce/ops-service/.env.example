# ops-service configuration. Copy to .env and fill in. NEVER commit .env.
# Generate random secrets with:  openssl rand -hex 32

# Safety: TEST_MODE=true uses simulated Shopify + suppliers. Leave true until
# every launch check in LAUNCH-CHECKLIST.md has passed.
TEST_MODE=true
PORT=8080
PUBLIC_BASE_URL=https://ops.example.co.uk
STORE_URL=https://www.example.co.uk

# Token n8n uses to call this service (32+ random characters)
OPS_API_TOKEN=

# Owner dashboard. Create the hash with:  npm run hash-password
DASHBOARD_USERNAME=owner
DASHBOARD_PASSWORD_HASH=
SECURE_COOKIES=true
SESSION_HOURS=12

# Shopify (Dev Dashboard app installed on your store — see SHOPIFY-SETUP.md)
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional instead of client id/secret: a long-lived Admin API token
SHOPIFY_ADMIN_TOKEN=
# Webhooks are signed with the app's client secret
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_LOCATION_ID=
SHOPIFY_NOTIFY_CUSTOMER=true

# n8n: where verified paid orders are forwarded, and the shared header secret
N8N_ORDER_WEBHOOK_URL=http://n8n:5678/webhook/ops-new-paid-order
N8N_SHARED_SECRET=

# Order safety limits (GBP)
AUTO_ORDER_MAX_GBP=75
DAILY_AUTO_ORDER_CAP_GBP=300
SHIP_TO_COUNTRIES=GB

# Supplier credentials (only for suppliers in mode "api")
CJ_API_KEY=
# Leave false: CJ orders are created unpaid and wait for your approval
CJ_AUTO_PAY=false

# AI drafting (optional). Hard monthly cap in GBP — calls stop when reached.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MONTHLY_BUDGET_GBP=15
USD_TO_GBP=0.79

# Budget alert threshold for projected monthly software costs
BUDGET_ALERT_GBP=80

# Data retention
PII_RETENTION_DAYS=90
LOG_RETENTION_DAYS=90

# Backups (16+ characters; store it in your password manager — without it backups cannot be restored)
BACKUP_PASSPHRASE=
