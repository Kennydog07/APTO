<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ shop.name }} &ndash; {{ 'password.coming_soon' | t }}</title>
    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {{ settings.type_heading_font | font_face: font_display: 'swap' }}
    {% render 'css-variables' %}
    <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent" class="main">{{ content_for_layout }}</main>
  </body>
</html>
