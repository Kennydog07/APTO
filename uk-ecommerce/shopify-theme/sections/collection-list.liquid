<section class="section section--surface" aria-labelledby="Collections-{{ section.id }}">
  <div class="page-width">
    <div class="section__header"><h2 id="Collections-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
    <div class="grid grid--1-2-3">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a class="collection-card" href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.collections_url }}{% endif %}" {{ block.shopify_attributes }}>
          <div class="collection-card__media">
            {%- if c.featured_image -%}
              {{ c.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '450, 900', alt: c.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="collection-card__body">
            <h3>{{ block.settings.title | default: c.title | default: 'Collection' | escape }}</h3>
            {%- if block.settings.text != blank -%}<p class="muted">{{ block.settings.text | escape }}</p>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by room" } ],
  "blocks": [ { "type": "collection", "name": "Collection", "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "title", "label": "Title override" },
    { "type": "text", "id": "text", "label": "Short description" }
  ] } ],
  "max_blocks": 6,
  "presets": [{ "name": "Collection list", "blocks": [
    { "type": "collection", "settings": { "title": "Kitchen cupboards", "text": "Shelf risers, turntables and drawer dividers." } },
    { "type": "collection", "settings": { "title": "Wardrobes & bedrooms", "text": "Hangers, under-bed and over-door storage." } },
    { "type": "collection", "settings": { "title": "Bathrooms & hallways", "text": "No-drill caddies, hooks and organisers." } }
  ] }]
}
{% endschema %}
