<section class="section" aria-labelledby="Hero-{{ section.id }}">
  <div class="page-width hero">
    <div class="hero__text">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h1 id="Hero-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}<a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
        {%- if section.settings.button2_label != blank -%}<a class="button button--secondary" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label | escape }}</a>{%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="hero__facts">
          {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400', alt: section.settings.image.alt }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Small-space storage" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Small spaces, sorted." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Renter-friendly storage that makes the most of cupboards, doors and awkward corners — no drilling required." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Use your own photography or images the supplier has licensed to you." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all storage" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "Delivery & returns" },
    { "type": "url", "id": "button2_link", "label": "Second button link" }
  ],
  "blocks": [
    { "type": "fact", "name": "Fact", "limit": 4, "settings": [ { "type": "text", "id": "text", "label": "Fact", "default": "Ships from UK stock", "info": "Only genuine, verifiable statements." } ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Hero", "blocks": [ { "type": "fact", "settings": { "text": "Ships from UK stock" } }, { "type": "fact", "settings": { "text": "No-drill options" } }, { "type": "fact", "settings": { "text": "14-day cancellation rights" } } ] }]
}
{% endschema %}
