<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width page-content rte">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {{ section.settings.text }}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Delivery information" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Orders are passed to our UK-based supplier, normally within one working day. Each product page shows the supplier's delivery estimate. You will receive tracking by email when your order is dispatched.</p>" },
    { "type": "checkbox", "id": "surface", "label": "Tinted background", "default": false }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
