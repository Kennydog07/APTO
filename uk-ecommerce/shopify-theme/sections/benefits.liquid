<section class="section" aria-labelledby="Benefits-{{ section.id }}">
  <div class="page-width">
    <div class="section__header"><h2 id="Benefits-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
    <div class="benefits">
      {%- for block in section.blocks -%}
        <div class="benefit" {{ block.shopify_attributes }}>
          <div class="benefit__icon">{% render 'icon', name: block.settings.icon %}</div>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer benefits",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Why shop with us" } ],
  "blocks": [ { "type": "benefit", "name": "Benefit", "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [ { "value": "truck", "label": "Delivery" }, { "value": "return", "label": "Returns" }, { "value": "shield", "label": "Checked" }, { "value": "ruler", "label": "Measurements" }, { "value": "home", "label": "Home" }, { "value": "chat", "label": "Support" } ] },
    { "type": "text", "id": "title", "label": "Title", "default": "Benefit" },
    { "type": "textarea", "id": "text", "label": "Text", "info": "Genuine, verifiable benefits only." }
  ] } ],
  "max_blocks": 6,
  "presets": [{ "name": "Customer benefits", "blocks": [
    { "type": "benefit", "settings": { "icon": "truck", "title": "Shipped from UK stock", "text": "We only list products held in UK warehouses, with tracked delivery. Estimates are shown on every product page." } },
    { "type": "benefit", "settings": { "icon": "ruler", "title": "Real measurements", "text": "Every listing shows the supplier's dimensions and materials so you can check it fits before you buy." } },
    { "type": "benefit", "settings": { "icon": "return", "title": "Your rights, clearly explained", "text": "Change your mind within 14 days of delivery. Faulty items are covered by the Consumer Rights Act." } }
  ] }]
}
{% endschema %}
