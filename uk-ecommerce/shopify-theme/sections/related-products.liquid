<section class="section section--surface" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related" aria-labelledby="Related-{{ section.id }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="section__header"><h2 id="Related-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
      <div class="grid grid--4">
        {%- for product in recommendations.products -%}{% render 'product-card', product: product %}{%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pairs well with" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 }
  ]
}
{% endschema %}
