<section class="section{% if section.settings.surface %} section--surface{% endif %}" aria-labelledby="Featured-{{ section.id }}">
  <div class="page-width">
    <div class="section__header">
      <div>
        <h2 id="Featured-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.collection != blank -%}<a class="link-arrow" href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }}</a>{%- endif -%}
    </div>
    <div class="grid grid--4">
      {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="card"><div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div><h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3></div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most useful right now" },
    { "type": "text", "id": "text", "label": "Text", "default": "Hand-picked, renter-friendly fixes for small UK homes." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "surface", "label": "Tinted background", "default": false }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
