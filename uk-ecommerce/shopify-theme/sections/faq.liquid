<section class="section{% if section.settings.surface %} section--surface{% endif %}" aria-labelledby="Faq-{{ section.id }}">
  <div class="page-width faq">
    <h2 id="Faq-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- for block in section.blocks -%}
      <details class="accordion" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question | escape }}</summary>
        <div class="accordion__content rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in section.blocks -%}
            { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" },
    { "type": "checkbox", "id": "surface", "label": "Tinted background", "default": false }
  ],
  "blocks": [ { "type": "question", "name": "Question", "settings": [
    { "type": "text", "id": "question", "label": "Question", "default": "Question" },
    { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
  ] } ],
  "presets": [{ "name": "FAQ", "blocks": [
    { "type": "question", "settings": { "question": "Where do you deliver?", "answer": "<p>We currently deliver to addresses in Great Britain. Delivery estimates from our UK suppliers are shown on each product page and at checkout.</p>" } },
    { "type": "question", "settings": { "question": "Will I get tracking?", "answer": "<p>Yes. As soon as the supplier dispatches your order we email you the carrier and tracking number.</p>" } },
    { "type": "question", "settings": { "question": "Can I return something if I change my mind?", "answer": "<p>Yes. You can cancel within 14 days of receiving your item. Contact us first and we will send the correct returns address. See our <a href=\"/policies/refund-policy\">returns policy</a>.</p>" } },
    { "type": "question", "settings": { "question": "Do the products need drilling?", "answer": "<p>Most of our range is chosen to be renter-friendly. Each product page says clearly how it fits.</p>" } }
  ] }]
}
{% endschema %}
