<section class="section section--surface" aria-labelledby="Newsletter-{{ section.id }}">
  <div class="page-width newsletter">
    <h2 id="Newsletter-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <p class="muted">{{ section.settings.text | escape }}</p>
    {%- form 'customer', id: 'NewsletterForm', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-message" role="status" tabindex="-1" autofocus>{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        <div class="newsletter__row">
          <div class="field">
            <label for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
            <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required autocorrect="off" autocapitalize="off">
          </div>
        </div>
        <label class="checkbox" for="NewsletterConsent-{{ section.id }}">
          <input id="NewsletterConsent-{{ section.id }}" type="checkbox" required>
          <span>{{ section.settings.consent_text | escape }} <a href="{{ routes.root_url }}policies/privacy-policy">{{ 'newsletter.privacy' | t }}</a>.</span>
        </label>
        <button type="submit" class="button">{{ 'newsletter.button' | t }}</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Small-space ideas, once a fortnight" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Practical storage ideas and new arrivals. No spam — unsubscribe at any time." },
    { "type": "textarea", "id": "consent_text", "label": "Consent statement", "default": "I agree to receive marketing emails. I can unsubscribe at any time using the link in every email. See our", "info": "Required for PECR-compliant consent." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
