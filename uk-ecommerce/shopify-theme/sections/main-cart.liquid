<section class="section">
  <div class="page-width">
    <h1>{{ 'cart.title' | t }}</h1>
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart" novalidate>
        <div>
          <ul class="cart-items">
            {%- for item in cart.items -%}
              <li class="cart-item">
                <a href="{{ item.url }}">{%- if item.image -%}{{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item.product.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}</a>
                <div>
                  <a href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a>
                  {%- unless item.product.has_only_default_variant -%}<div class="muted">{{ item.variant.title | escape }}</div>{%- endunless -%}
                  <div>{{ item.final_price | money }}</div>
                  <div class="cart-item__actions">
                    <div class="field" style="max-width:110px">
                      <label for="Qty-{{ item.key }}" class="visually-hidden">{{ 'products.quantity' | t }}</label>
                      <input id="Qty-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
                    </div>
                    <a href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
                    <strong>{{ item.final_line_price | money }}</strong>
                  </div>
                </div>
              </li>
            {%- endfor -%}
          </ul>
          <p><button type="submit" name="update" class="button button--secondary">{{ 'cart.update' | t }}</button></p>
        </div>
        <aside class="cart-summary" aria-label="{{ 'cart.summary' | t }}">
          <p style="display:flex;justify-content:space-between"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money_with_currency }}</strong></p>
          <p class="muted" style="font-size:.9rem">{{ 'cart.taxes_shipping' | t }}</p>
          <button type="submit" name="checkout" class="button button--full">{{ 'cart.checkout' | t }}</button>
          <p class="muted" style="font-size:.85rem;margin-top:12px">{{ 'cart.rights' | t }}</p>
        </aside>
      </form>
    {%- else -%}
      <p>{{ 'cart.empty' | t }}</p>
      <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Cart" }
{% endschema %}
