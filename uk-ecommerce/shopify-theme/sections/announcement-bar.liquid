{%- if section.settings.text != blank -%}
  <div class="announcement" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      {{ section.settings.text | escape }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-section",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "UK delivery from UK warehouses · 14-day cancellation rights", "info": "Only state facts you can honour. Avoid false urgency." },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
