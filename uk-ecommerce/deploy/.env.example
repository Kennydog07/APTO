# Docker Compose settings (copy to .env). Secrets: generate with  openssl rand -hex 32
N8N_DOMAIN=n8n.example.co.uk
OPS_DOMAIN=ops.example.co.uk
ACME_EMAIL=you@example.com
N8N_ENCRYPTION_KEY=
# Used by deploy/scripts/backup.sh — store a copy in your password manager.
BACKUP_PASSPHRASE=
# Optional off-site copy with rclone (e.g. "b2:my-bucket/shop-backups"); leave blank to skip
RCLONE_REMOTE=
