{
  "id": "NoWf04Pricing000",
  "name": "04 — Pricing monitor (twice daily)",
  "active": false,
  "nodes": [
    {
      "id": "c2da07b5-6e9e-4bac-a0bb-6155005b2bff",
      "position": [
        260,
        300
      ],
      "name": "07:00 and 19:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7,19 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "d50f406d-be7f-431c-ac07-78fdc5bf3c5c",
      "position": [
        520,
        300
      ],
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Edit n8n-workflows/config.json and rebuild, or change here.\nconst _cfg = {\"opsBaseUrl\":\"http://ops-service:8080\",\"ownerEmail\":\"owner@example.com\",\"storeEmail\":\"hello@example.co.uk\",\"storeName\":\"Nook & Order\",\"testMode\":true};\nconst items = $input.all();\nreturn (items.length ? items : [{ json: {} }]).map((i) => ({ json: { ...i.json, _cfg } }));"
      }
    },
    {
      "id": "17d5afc6-29db-4cd5-8b6e-0a5ec9539d56",
      "position": [
        780,
        300
      ],
      "name": "Recalculate margins",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json._cfg.opsBaseUrl }}/api/pricing/monitor",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_OPS_API_CRED",
          "name": "Ops service API (Bearer)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "c4018ed4-3c15-4ae6-955b-976b9d9bee1b",
      "position": [
        1040,
        300
      ],
      "name": "Log run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json._cfg.opsBaseUrl }}/api/logs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: \"wf04\", level: 'info', message: \"Pricing monitor complete\", data: { reviewed: ($json.reviews ?? []).length } }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_OPS_API_CRED",
          "name": "Ops service API (Bearer)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "continueOnFail": true
    },
    {
      "id": "5d04f84f-8972-4ae4-bab6-3cabc762f7b0",
      "name": "Manual test run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        260,
        460
      ],
      "parameters": {}
    }
  ],
