          },
          "conditions": [
            {
              "id": "1d51e968-7d0e-4728-ae7c-031cf4f3c922",
              "leftValue": "={{ $('Config').first().json._cfg.testMode }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "1a62d496-3bdb-4a35-9ddc-e857a2f1f381",
      "position": [
        1560,
