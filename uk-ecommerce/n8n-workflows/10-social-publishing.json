      "position": [
        260,
        300
      ],
      "name": "Hourly 09:00–20:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "5 9-20 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "91fec804-7cca-4e1a-b686-1f66b97534da",
      "position": [
        520,
        300
      ],
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Edit n8n-workflows/config.json and rebuild, or change here.\nconst _cfg = {\"opsBaseUrl\":\"http://ops-service:8080\",\"ownerEmail\":\"owner@example.com\",\"storeEmail\":\"hello@example.co.uk\",\"storeName\":\"Nook & Order\",\"testMode\":true};\nconst items = $input.all();\nreturn (items.length ? items : [{ json: {} }]).map((i) => ({ json: { ...i.json, _cfg } }));"
      }
    },
    {
      "id": "a7fa2afc-f29b-44aa-8b75-1fa08cf14d54",
      "position": [
        780,
        300
      ],
      "name": "Get approved, due Pinterest pins",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json._cfg.opsBaseUrl }}/api/marketing/due?channel=pinterest",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_OPS_API_CRED",
          "name": "Ops service API (Bearer)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "769c7ab2-3a86-48be-9b70-cf20b097673d",
      "position": [
        1040,
        300
      ],
      "name": "One item per pin",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.paused) return [];\nreturn (r.items ?? []).filter((i) => i.status === 'approved').map((i) => ({ json: i }));"
      }
    },
    {
      "id": "b12d9546-56be-48e9-8c31-f750ffca8d8c",
      "position": [
        1300,
        300
      ],
      "name": "Test mode?",
