      ],
      "name": "Create Pinterest pin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.pinterest.com/v5/pins",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ board_id: \"REPLACE_BOARD_ID\", title: $json.title, description: $json.body, link: $json.meta.link, media_source: { source_type: 'image_url', url: $json.meta.imageUrl } }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
