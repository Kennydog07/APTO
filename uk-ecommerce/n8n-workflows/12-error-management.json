    {
      "id": "20d164f4-8889-41b7-af8b-af77d173a330",
      "position": [
        1300,
        300
      ],
      "name": "Anything to tell the owner?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "528c02fe-47b9-416f-bec2-d0945ac5b2d6",
              "leftValue": "={{ ($json.alerts ?? []).length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "837f44e6-68c7-41b5-8f53-e2872b58b20b",
      "position": [
        1560,
        200
      ],
      "name": "Format alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const a = $input.first().json.alerts;\nreturn [{ json: { subject: `${a.length} issue(s) need your attention`, text: a.map((x) => `[${x.severity.toUpperCase()}] ${x.message} (seen ${x.occurrences}×)`).join('\\n') + '\\n\\nDetails: dashboard → Alerts.' } }];"
      }
    },
    {
      "id": "15b380fe-b996-4255-b3a9-102f73dadf11",
      "position": [
        1820,
        200
      ],
      "name": "Alert owner",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "parameters": {
        "fromEmail": "={{ $('Config (poll)').isExecuted ? $('Config (poll)').first().json._cfg.storeEmail : $('Config').first().json._cfg.storeEmail }}",
        "toEmail": "={{ $('Config (poll)').isExecuted ? $('Config (poll)').first().json._cfg.ownerEmail : $('Config').first().json._cfg.ownerEmail }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "REPLACE_SMTP_CRED",
          "name": "Store SMTP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000
    },
