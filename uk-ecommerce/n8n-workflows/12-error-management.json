    {
      "id": "6dd1f673-c0e3-431d-b460-3fdd5ea2e7c6",
      "position": [
        520,
        200
      ],
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Edit n8n-workflows/config.json and rebuild, or change here.\nconst _cfg = {\"opsBaseUrl\":\"http://ops-service:8080\",\"ownerEmail\":\"owner@example.com\",\"storeEmail\":\"hello@example.co.uk\",\"storeName\":\"Nook & Order\",\"testMode\":true};\nconst items = $input.all();\nreturn (items.length ? items : [{ json: {} }]).map((i) => ({ json: { ...i.json, _cfg } }));"
      }
    },
    {
      "id": "9126acc3-2dc2-403f-816f-e9aac2b8d948",
      "position": [
        780,
        200
      ],
      "name": "Record error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json._cfg.opsBaseUrl }}/api/errors",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: $('Workflow failed').first().json.workflow?.name, executionId: $('Workflow failed').first().json.execution?.id, node: $('Workflow failed').first().json.execution?.lastNodeExecuted, message: $('Workflow failed').first().json.execution?.error?.message ?? 'Unknown error', url: $('Workflow failed').first().json.execution?.url, severity: 'error' }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_OPS_API_CRED",
          "name": "Ops service API (Bearer)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "continueOnFail": true
    },
    {
      "id": "0c7ac4b1-8545-4a88-8b32-b9810d576157",
      "position": [
        260,
        420
      ],
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      }
    },
    {
      "id": "a46aa5ad-e383-4cb4-ae06-87a1c376b954",
